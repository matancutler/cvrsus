# Copy this file to .env and change the values before using this with real CVs.

# COMPANY_SIGNUP_SECRET is gone (audit §15). Company registration is open, and
# a new company is created "pending": it can sign in and finish setting up, but
# reaches no candidate profile until it is approved. Approve one with:
#   node server/scripts/companies.mjs approve <id>

# Secret used to sign session tokens and hash sign-in codes. Use a long random
# string. Changing it signs everyone out and invalidates pending codes.
SESSION_SECRET=replace-with-a-long-random-string

# Port the API listens on.
PORT=5175

# How long a signed-in session stays valid, in hours.
SESSION_HOURS=12

# Candidate sign-in codes are printed to the server console because no email or
# SMS provider is wired up. While OTP_ECHO is true the code is ALSO returned in
# the API response so the flow is usable without a mailbox.
# This must be false in production: with it on, knowing a candidate's email
# address is enough to sign in as them.
OTP_ECHO=true

# ---------------------------------------------------------------------- AI ---

# Claude reads each CV on upload and judges each candidate against the job
# description during a search. Without this key both fall back to the
# deterministic keyword path, which still works but only matches on wording.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# How many candidates Claude reads in full per search. Each one is a separate
# request, so this bounds latency and spend; everyone below the cut keeps their
# keyword score and is labelled as such in the results.
AI_RANK_LIMIT=25

# Semantic search. Each profile is turned into a vector once, and a job
# description is matched against those by meaning rather than wording — so a CV
# saying "Vue design system" surfaces for a React role. This decides WHICH
# profiles Claude reads, not how they score.
#
# Anthropic has no embeddings endpoint; their docs point at Voyage AI, which is
# what this uses. Without a key, shortlisting falls back to keyword overlap.
# Get one at https://dashboard.voyageai.com
VOYAGE_API_KEY=

# The embedding model. Changing it invalidates every stored vector — they are
# only comparable within one model — so profiles are re-embedded on next edit.
VOYAGE_MODEL=voyage-3

# Landing-page stats banner: minimum candidates before it is shown.
# 0 shows it from the first sign-up. Default when unset: 25.
STATS_MIN=25

# ---------------------------------------------------------------- billing ---
#
# Recruiters buy prepaid reveals and one-time seats. Every price and quantity
# lives in server/src/pricing.js; these override the defaults there without a
# code change. Amounts are in MINOR units (agorot), always integers.

# Which processor takes the money. 'local' records purchases and treats them as
# settled without charging anything, which is what you want until a real
# integration exists. 'stripe' throws on purchase rather than quietly giving
# product away, so selecting it before finishing the integration fails loudly.
BILLING_PROVIDER=local
BILLING_CURRENCY=ILS

# Reveals granted once to each new organization, so a recruiter can judge the
# candidates before paying for any. Set to 0 to turn the grant off.
COMPLIMENTARY_REVEALS=10

# Recruiter accounts included with every organization, before any are bought.
# One is the administrator's own seat; every colleague after that is bought.
INCLUDED_SEATS=1

# Undiscounted price of one seat, and where self-serve stops and Contact Sales
# begins. The tier table in pricing.js discounts down from this base.
SEAT_BASE_PRICE=8000
SEAT_SELF_SERVE_MAX=5

# Cumulative true-up: price the tier on the organization's total seats after the
# purchase, crediting what it already paid, so buying one at a time costs the
# same as buying them all at once. 'false' prices each purchase on its own size.
SEAT_TRUE_UP=true

# Balances at which the workspace starts warning, highest first.
LOW_BALANCE_THRESHOLDS=10,5

# --- Email delivery (Resend) -------------------------------------------------
#
# Leave RESEND_API_KEY unset and every email is printed to the server console
# instead of sent. That is the default and it is what the test suite runs on.
#
# Addresses on the domains RFC 2606 reserves for testing - example.com, .test,
# .invalid, localhost - are never delivered to even when a key is set. Every
# fixture in test/ writes to one of those, so a key in your environment cannot
# turn a test run into a live mailing.
RESEND_API_KEY=

# Resend will only send from a domain verified in your Resend account. Until
# one is, the default sender is Resend own onboarding@resend.dev, which
# delivers only to the address that owns the account - enough to prove the
# wiring, useless for candidates.
#
# Verify a subdomain rather than the root: sending records live on
# mail.cvrsvs.com, receiving records (Cloudflare Email Routing) stay on
# cvrsvs.com, and the two cannot collide.
# MAIL_FROM=Cursus <no-reply@mail.cvrsvs.com>

# Where a reply goes, since the From is a no-reply. Needs a real mailbox -
# Resend sends but does not receive.
# MAIL_REPLY_TO=support@cvrsvs.com

# --- Duplicate exemptions ----------------------------------------------------
#
# One mailbox is one account and one number is one account, enforced by a unique
# index on a canonical key. Anything listed here is carved out of that index, so
# it may appear on more than one candidate.
#
# It exists so an operator can walk through signup repeatedly with their own
# address and handset, where the codes actually arrive.
#
# This variable SETS the list; it is not the list. Whatever it says is written
# into the database and stands until it is changed, so a process started without
# it — a test run, a one-off script, a migration — inherits the stored answer
# instead of rebuilding the index with no exemptions at all. Setting it to an
# empty value is an instruction: it clears the list. Nothing is exempt until
# something says otherwise, which is the right default.
#
# Note the cost: sign-in resolves an address to the NEWEST matching row, so
# earlier duplicates become unreachable from the sign-in page. Fine for
# throwaway test accounts, wrong for anybody real.
DUPLICATE_EXEMPT_CONTACTS=
