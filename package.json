    "test:triage-draft-ux": "node test/triage-draft-ux-check.mjs",
    "test:triage-history": "node test/triage-history-check.mjs",
    "test:comments": "node test/comments-check.mjs",
    "test:triage-funnel": "node test/triage-funnel-check.mjs",
    "test:triage-capacity": "node test/triage-capacity-check.mjs",
    "test:triage-skip": "node test/triage-skip-check.mjs",
    "test:cost": "node test/ai-cost-check.mjs",
    "test:explain": "node test/explain-route-check.mjs",
    "test:triage-drop": "node test/triage-drop-check.mjs",
