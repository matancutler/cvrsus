    "ai:health": "node server/scripts/ai-health.mjs",
    "ai:cost": "node server/scripts/ai-cost.mjs",
    "ai:prefix": "node server/scripts/ai-prefix.mjs",
    "ai:eval": "node server/scripts/ai-eval.mjs",
    "score:migrate": "node server/scripts/score-migrate.mjs",
    "triage:audit": "node server/scripts/triage-audit.mjs",
    "triage:retention": "node server/scripts/triage-retention.mjs",
    "sweep:quarantine": "node server/scripts/sweep-quarantine.mjs",
    "data:test": "node server/scripts/test-data.mjs",
