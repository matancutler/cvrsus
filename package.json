    "test:cookies": "node test/cookie-auth-check.mjs",
    "test:session-refresh": "node test/session-refresh-check.mjs",
    "test:stats": "node test/stats-banner-check.mjs",
    "test:pricing": "node test/pricing-check.mjs",
    "test:legal": "node test/legal-check.mjs",
    "test:folders": "node test/folder-status-check.mjs",
    "test:portal": "node test/portal-check.mjs",
    "test:persistence": "node test/persistence-check.mjs",
    "test:usage": "node test/usage-check.mjs",
    "test:export": "node test/export-check.mjs",
    "test:comms": "node test/comms-check.mjs",
    "test:summary-companies": "node test/summary-companies-check.mjs",
